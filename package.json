{
  "name": "libraos",
  "displayName": "LibraOS — AI Runtime for VS Code",
  "description": "Install, run and integrate the LibraOS Runtime into your existing app, from VS Code.",
  "version": "0.3.1",
  "preview": true,
  "publisher": "libraos",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/libraos/vscode"
  },
  "bugs": {
    "url": "https://github.com/libraos/vscode/issues"
  },
  "homepage": "https://libraos.com",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "libraos",
    "ai",
    "agents",
    "runtime",
    "llm"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.libraos/source.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "libraos",
          "title": "LibraOS",
          "icon": "media/libraos.svg"
        }
      ]
    },
    "views": {
      "libraos": [
        {
          "id": "libraos.workspace",
          "name": "My Workspace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "libraos.workspace",
        "contents": "Welcome to LibraOS\nAdd the AI Core to your project."
      }
    ],
    "commands": [
      {
        "command": "libraos.refresh",
        "title": "Refresh",
        "category": "LibraOS",
        "icon": "$(refresh)"
      },
      {
        "command": "libraos.signIn",
        "title": "Sign In",
        "category": "LibraOS"
      },
      {
        "command": "libraos.signOut",
        "title": "Sign Out",
        "category": "LibraOS"
      },
      {
        "command": "libraos.claimLicence",
        "title": "Claim Developer Licence",
        "category": "LibraOS"
      },
      {
        "command": "libraos.registerInstallation",
        "title": "Register This Instance for Developer Benefits",
        "category": "LibraOS"
      },
      {
        "command": "libraos.removeInstallation",
        "title": "Remove Benefit-Registered Instance",
        "category": "LibraOS",
        "icon": "$(trash)"
      },
      {
        "command": "libraos.openConsole",
        "title": "Open Console",
        "category": "LibraOS"
      },
      {
        "command": "libraos.configureModel",
        "title": "Configure Model",
        "category": "LibraOS"
      },
      {
        "command": "libraos.installRuntime",
        "title": "Install Runtime",
        "category": "LibraOS"
      },
      {
        "command": "libraos.startRuntime",
        "title": "Run Local Runtime",
        "category": "LibraOS",
        "icon": "$(play)"
      },
      {
        "command": "libraos.stopRuntime",
        "title": "Stop Local Runtime",
        "category": "LibraOS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "libraos.showLogs",
        "title": "Show Runtime Logs",
        "category": "LibraOS"
      },
      {
        "command": "libraos.initProject",
        "title": "Initialize LibraOS Project",
        "category": "LibraOS"
      },
      {
        "command": "libraos.copyApiKey",
        "title": "Copy Project API Key",
        "category": "LibraOS"
      },
      {
        "command": "libraos.browseExamples",
        "title": "Browse Cookbook",
        "category": "LibraOS"
      },
      {
        "command": "libraos.openExample",
        "title": "Get Example",
        "category": "LibraOS"
      },
      {
        "command": "libraos.getExample",
        "title": "Get Example",
        "category": "LibraOS",
        "icon": "$(cloud-download)"
      },
      {
        "command": "libraos.showExampleNeeds",
        "title": "What This Example Needs",
        "category": "LibraOS",
        "icon": "$(info)"
      },
      {
        "command": "libraos.openExampleTutorial",
        "title": "Open Example Tutorial",
        "category": "LibraOS",
        "icon": "$(book)"
      },
      {
        "command": "libraos.viewExampleSource",
        "title": "View Example on GitHub",
        "category": "LibraOS",
        "icon": "$(github)"
      },
      {
        "command": "libraos.openLearningPaths",
        "title": "Open Cookbook Learning Paths",
        "category": "LibraOS"
      },
      {
        "command": "libraos.cookbookSetupGuide",
        "title": "Cookbook Setup or This Runtime?",
        "category": "LibraOS"
      },
      {
        "command": "libraos.cloudDeploy",
        "title": "Cloud Deployment (Coming Soon)",
        "category": "LibraOS"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "libraos.refresh",
          "when": "view == libraos.workspace",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "libraos.openExample",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "libraos.removeInstallation",
          "when": "view == libraos.workspace && viewItem == libraos.installation",
          "group": "inline"
        },
        {
          "command": "libraos.showExampleNeeds",
          "when": "view == libraos.workspace && viewItem == libraos.example",
          "group": "inline@1"
        },
        {
          "command": "libraos.openExampleTutorial",
          "when": "view == libraos.workspace && viewItem == libraos.example",
          "group": "inline@2"
        },
        {
          "command": "libraos.viewExampleSource",
          "when": "view == libraos.workspace && viewItem == libraos.example",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "LibraOS",
      "properties": {
        "libraos.runtime.port": {
          "type": "number",
          "default": 8900,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local port the runtime listens on (bound to 127.0.0.1 only)."
        },
        "libraos.runtime.postgresPort": {
          "type": "number",
          "default": 55432,
          "minimum": 1,
          "maximum": 65535,
          "description": "Loopback port for the runtime's Postgres on Linux, where the runtime uses host networking."
        },
        "libraos.runtime.image": {
          "type": "string",
          "default": "ghcr.io/libraos/libraos:v0.2.2@sha256:0ccb121cd5760af47a91c491010a63123030533ebe516bd732d94a0575dccdc2",
          "description": "Runtime container image. Pin a digest (@sha256:…) so Docker verifies what it pulls."
        },
        "libraos.model.baseUrl": {
          "type": "string",
          "default": "https://api.meganova.ai",
          "description": "OpenAI-compatible model endpoint the runtime calls, e.g. https://api.meganova.ai, a local proxy such as http://127.0.0.1:8318/v1, or Ollama at http://127.0.0.1:11434/v1."
        },
        "libraos.model.name": {
          "type": "string",
          "default": "Qwen/Qwen3.6-35B-A3B",
          "description": "Model the runtime uses for answers, planning and tools."
        },
        "libraos.consoleUrl": {
          "type": "string",
          "default": "https://console.libraos.com",
          "description": "LibraOS Developer Console. Sign-in and licences use it; your session token is sent only to this address."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "test:integration": "npm run build && node test/integration/run.js",
    "test:e2e": "npm run build && node test/integration/e2e/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
